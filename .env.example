# Copy to .env and adjust. All variables are optional; defaults are shown.

# SQLAlchemy database URL. SQLite for dev/tests; Postgres e.g.
# postgresql+psycopg://user:password@localhost:5432/beautycrawler
DATABASE_URL=sqlite:///beautycrawler.db

# Crawler identity and politeness
BEAUTYCRAWLER_USER_AGENT="BeautyCrawler/0.1 (+https://github.com/Muredepadure/Beauty-Product-Crawler)"
# Minimum seconds between requests to the same domain (must be >= 2)
BEAUTYCRAWLER_REQUEST_DELAY_SECONDS=2.0
BEAUTYCRAWLER_REQUEST_TIMEOUT_SECONDS=30
BEAUTYCRAWLER_MAX_RETRIES=3
BEAUTYCRAWLER_RETRY_BACKOFF_SECONDS=2.0
BEAUTYCRAWLER_ROBOTS_CACHE_TTL_SECONDS=86400

# Streamlit UI -> API
BEAUTYCRAWLER_API_BASE_URL=http://localhost:8000/api
